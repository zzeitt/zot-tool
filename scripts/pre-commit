#!/bin/bash
# Pre-commit hook: block commits containing sensitive info.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Bypass:  git commit --no-verify

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

VIOLATIONS=0

# Get staged changes, excluding the hook files themselves
STAGED_FILES=$(git diff --cached --name-only --diff-filter=AM \
    | grep -v -E 'scripts/pre-commit|\.git/hooks/')
if [ -n "$STAGED_FILES" ]; then
    STAGED=$(echo "$STAGED_FILES" | xargs git diff --cached --unified=0 --diff-filter=AM --)
else
    STAGED=""
fi

# -----------------------------------------------------------------------
# Rule 1: ZOTERO_API_KEY assignment with a non-empty value
# -----------------------------------------------------------------------
# Catches: ZOTERO_API_KEY = "abc123..."  or  ZOTERO_API_KEY=abc123
# Skips:   ZOTERO_API_KEY (bare variable reference)
API_KEY_HITS=$(echo "$STAGED" | grep -nE '^\+\s*ZOTERO_API_KEY\s*=\s*["'"'"']?[A-Za-z0-9_\-]{8,}' || true)
if [ -n "$API_KEY_HITS" ]; then
    echo -e "${RED}[BLOCKED] ZOTERO_API_KEY assignment detected:${NC}"
    echo "$API_KEY_HITS" | while read -r line; do
        echo -e "  ${YELLOW}$line${NC}"
    done
    VIOLATIONS=$((VIOLATIONS + 1))
fi

# -----------------------------------------------------------------------
# Rule 2: Nutstore / MyNutstore paths
# -----------------------------------------------------------------------
NUTSTORE_HITS=$(echo "$STAGED" | grep -inE 'MyNutstore|\\\\Nutstore|Nutstore\\\\' || true)
if [ -n "$NUTSTORE_HITS" ]; then
    echo -e "${RED}[BLOCKED] Nutstore path detected:${NC}"
    echo "$NUTSTORE_HITS" | while read -r line; do
        echo -e "  ${YELLOW}$line${NC}"
    done
    VIOLATIONS=$((VIOLATIONS + 1))
fi

# -----------------------------------------------------------------------
# Rule 3: WebDAV credential assignments
# -----------------------------------------------------------------------
WEBDAV_HITS=$(echo "$STAGED" | grep -nE '^\+\s*ZOTERO_WEBDAV_(URL|USER|PASS)\s*=\s*["'"'"']?[A-Za-z0-9@:/._\-]{4,}' || true)
if [ -n "$WEBDAV_HITS" ]; then
    echo -e "${RED}[BLOCKED] WebDAV credential assignment detected:${NC}"
    echo "$WEBDAV_HITS" | while read -r line; do
        echo -e "  ${YELLOW}$line${NC}"
    done
    VIOLATIONS=$((VIOLATIONS + 1))
fi

# -----------------------------------------------------------------------
# Rule 4: Hardcoded Zotero collection/item keys (8-char uppercase alnum)
#          in variable *value* position (not variable *name* position).
# -----------------------------------------------------------------------
# Matches lines like:   FORBIDDEN_COLLECTION = "E2MM3WIC"
# or bare keys used as: coll = "E2MM3WIC" / key = "E2MM3WIC"
# Skips lines where the key is the env var name itself.
KEY_VAL_HITS=$(echo "$STAGED" | grep -nP '^\+\s*(?!ZOTERO_|export ZOTERO_)\w+\s*=\s*["'"'"']?[A-Z0-9]{8}["'"'"']?' || true)
if [ -n "$KEY_VAL_HITS" ]; then
    echo -e "${RED}[BLOCKED] Hardcoded Zotero key value detected (8-char uppercase):${NC}"
    echo "$KEY_VAL_HITS" | while read -r line; do
        echo -e "  ${YELLOW}$line${NC}"
    done
    echo -e "  ${YELLOW}If this is a test/dummy key, use a clearly fake value like 'XXXXXXXX'.${NC}"
    VIOLATIONS=$((VIOLATIONS + 1))
fi

# -----------------------------------------------------------------------
# Rule 5: ZOTERO_LIBRARY_ID assignment with a value (numeric, 6+ digits)
# -----------------------------------------------------------------------
LIBID_HITS=$(echo "$STAGED" | grep -nE '^\+\s*ZOTERO_LIBRARY_ID\s*=\s*["'"'"']?\d{6,}' || true)
if [ -n "$LIBID_HITS" ]; then
    echo -e "${RED}[BLOCKED] ZOTERO_LIBRARY_ID assignment detected:${NC}"
    echo "$LIBID_HITS" | while read -r line; do
        echo -e "  ${YELLOW}$line${NC}"
    done
    VIOLATIONS=$((VIOLATIONS + 1))
fi

# -----------------------------------------------------------------------
# Result
# -----------------------------------------------------------------------
if [ "$VIOLATIONS" -gt 0 ]; then
    echo ""
    echo -e "${RED}Commit blocked: $VIOLATIONS sensitive info violation(s) found.${NC}"
    echo "Bypass (emergency only): git commit --no-verify"
    exit 1
fi

exit 0
